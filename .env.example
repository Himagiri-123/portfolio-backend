# Copy this file to .env and fill in real values.
# .env is already in .gitignore - never commit real secrets.

MONGODB_URI=your-mongodb-connection-string
PORT=5000

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Change this password immediately - the old one was hardcoded in
# admin-script.js and pushed to a public GitHub repo.
ADMIN_USER=choose-a-new-username
ADMIN_PASS=choose-a-new-strong-password
